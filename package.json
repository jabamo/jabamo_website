    "test:coverage": "vitest --coverage tests/components tests/pages tests/utils tests/composables"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/sitemap": "^9.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.6.2",
    "swiper": "^14.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.19",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
